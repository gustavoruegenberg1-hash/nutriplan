# ==========================================
# NutriPlan v2 - Variáveis de Ambiente da API
# ==========================================

# Porta HTTP do servidor NestJS
PORT=3000

# Chave secreta para assinatura dos tokens JWT (RFC 7519)
# Em ambiente de produção, utilize uma chave forte de no mínimo 32 caracteres gerada aleatoriamente
JWT_SECRET=chave_secreta_jwt_producao_nutriplan_2026_exemplo

# Caminho do arquivo SQLite (ou :memory: para testes voláteis)
DATABASE_PATH=nutriplan.sqlite
